{
  "name": "dsh-rea-switch",
  "version": "0.1.2",
  "description": "DeepSeek Harness 设置页开关：一键启用/停用 REA MCP 服务器（rea-mcp 行），并显示它对 system prompt 的开销。",
  "repository": {
    "type": "git",
    "url": "git@github.com:smounives/dsh-rea-switch.git"
  },
  "homepage": "https://github.com/smounives/dsh-rea-switch#readme",
  "bugs": {
    "url": "https://github.com/smounives/dsh-rea-switch/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "rea"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/"
  }
}
